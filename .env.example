# Copy to .env.local and fill in. Every variable is read through src/lib/env.ts.
# A blank value counts as unset.

# ---------------------------------------------------------------------------
# Data mode
# ---------------------------------------------------------------------------

# "local" — a JSON file under .data/, no external services (the demo mode).
# "supabase" — the real project below.
# Unset: supabase when real credentials are present, local otherwise — except
# in production, where it must be set (or Supabase configured) or the server
# refuses to start serving: a deploy never falls back to demo data silently.
ROSTER_DATA=local

# Optional. Where local mode keeps its JSON database and generated secret.
# Defaults to ./.data
# ROSTER_DATA_DIR=

# Signs the local-mode session cookie. At least 32 characters.
# Optional in development (a secret is generated into .data/ on first use);
# REQUIRED when NODE_ENV=production and the app runs in local mode.
# Generate with: openssl rand -hex 32
ROSTER_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Supabase (required when ROSTER_DATA=supabase)
# ---------------------------------------------------------------------------

# Project Settings → API. The placeholders below are detected and treated as
# "not configured", so a fresh clone falls back to local mode.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row-level security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_. Read by src/lib/supabase/admin.ts
# for one thing: deleting an account from Settings (auth.admin.deleteUser).
# Without it, account deletion reports itself unavailable.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------

# Public origin, no trailing slash. Used for robots.txt, the sitemap, the
# handle prefix shown in the UI, and the verification links coaches receive.
# Defaults to https://roster.us
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. In Supabase mode the landing page's sample resume is fixture data
# unless this names a real resume to feature — only set it with that
# athlete's consent. Local mode always uses the seeded demo athlete.
# ROSTER_DEMO_HANDLE=

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------

# Verification requests email the coach their link; answers email the athlete.
# Unset: nothing is sent — each message is logged and appended to
# $ROSTER_DATA_DIR/email-outbox.json, so local mode and the e2e run need no key.
# https://resend.com/api-keys
RESEND_API_KEY=

# The From header. Must be on a domain verified in Resend.
# Defaults to "Roster <noreply@myroster.us>".
# EMAIL_FROM=

# ---------------------------------------------------------------------------
# Rate limiting (src/lib/rate-limit.ts)
# ---------------------------------------------------------------------------

# Sign-in, sign-up, password reset, the handle checker, coach verify answers,
# and profile reports are limited per client address (and per email / link
# where there is one). In-memory, per instance: a speed bump in front of
# Supabase's own auth limits, not a replacement for them.
#
# Unset: ON, except when NODE_ENV=test or ROSTER_DATA=local — the demo and
# the e2e/audit runs sign in dozens of times from one address.
#   off — never limit (load tests)
#   on  — always limit, even in local mode (to try the limits by hand)
# ROSTER_RATE_LIMIT=

# ---------------------------------------------------------------------------
# Observability (src/lib/logger.ts, src/instrumentation.ts, /api/health)
# ---------------------------------------------------------------------------

# Server logs are one JSON object per line. debug | info | warn | error | silent.
# Defaults to info (warn under NODE_ENV=test).
# ROSTER_LOG_LEVEL=

# Optional. Server errors (instrumentation onRequestError), client render
# errors (error.tsx → /api/errors), and logger.error calls are forwarded here.
# Both are no-ops when unset; set either or both.
#
# Sentry project DSN — sent as a plain envelope POST, no SDK needed:
# SENTRY_DSN=https://<key>@o000000.ingest.sentry.io/0000000
#
# Any endpoint that accepts a JSON POST. The body carries `text`, so a Slack
# or Discord incoming-webhook URL works as is:
# ROSTER_ALERT_WEBHOOK_URL=
