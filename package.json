{
  "name": "roster",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "shots": "node scripts/shots.mjs",
    "test:schema": "./supabase/tests/run.sh",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "test": "tsx --conditions=react-server --test src/lib/data/__tests__/*.test.ts",
    "seed": "tsx --conditions=react-server scripts/seed.ts",
    "e2e": "node scripts/smoke.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.109.0",
    "motion": "^13.2.0",
    "next": "16.3.2",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "playwright-core": "^1.62.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
