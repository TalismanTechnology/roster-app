# Last updated: 2026-09-11. Placeholders only; copy to ignored .env.local.
# Development fixtures: keep local. Production requires supabase.
ROSTER_DATA=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server/job only: never prefix this with NEXT_PUBLIC_ or put it in client logs.
SUPABASE_SERVICE_ROLE_KEY=replace-with-verified-server-key
# Optional local-only data directory and session signing secret:
# ROSTER_DATA_DIR=/absolute/private/path/to/roster-demo
# ROSTER_SESSION_SECRET=replace-with-a-long-random-local-secret
# Optional separate build directory, shared by build and start:
# ROSTER_NEXT_OUTPUT=.next-release
